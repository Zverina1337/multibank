# Database
STORAGE_POSTGRES_URL=url-to-your-postgres-database
STORAGE_PRISMA_DATABASE_URL=url-to-your-postgres-database
STORAGE_PRISMA_DATABASE_URL=url-to-your-postgres-database

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Yandex GPT
YANDEX_GPT_API_KEY="your-yandex-api-key"
YANDEX_GPT_CATALOG_ID="your-catalog-id"

# Payment Gateway (опционально, для подписок)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# App Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags
ENABLE_AI_FEATURES="true"
ENABLE_SUBSCRIPTIONS="true"

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE="60"
AI_RATE_LIMIT_PER_DAY="100"
