# Database
DATABASE_URL="postgresql://user:password@localhost:5432/multibank?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Upstash Redis (для кэширования)
UPSTASH_REDIS_REST_URL="your-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Yandex GPT
YANDEX_GPT_API_KEY="your-yandex-api-key"
YANDEX_GPT_CATALOG_ID="your-catalog-id"

# Banking APIs (замени на реальные после получения доступа)
VTB_API_KEY="your-vtb-api-key"
VTB_API_URL="https://api.vtb.ru"

SBER_API_KEY="your-sber-api-key"
SBER_API_URL="https://api.sber.ru"

TINKOFF_API_KEY="your-tinkoff-api-key"
TINKOFF_API_URL="https://api.tinkoff.ru"

# Payment Gateway (опционально, для подписок)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# App Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags
ENABLE_AI_FEATURES="true"
ENABLE_SUBSCRIPTIONS="true"

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE="60"
AI_RATE_LIMIT_PER_DAY="100"
